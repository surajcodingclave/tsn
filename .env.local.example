# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/transport

# Secret used to sign JWTs (change in production)
JWT_SECRET=change-me-to-a-long-random-string

# Google Maps browser key (used on client maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google server key with Geocoding API enabled (used for address -> lat/lng)
GOOGLE_GEOCODE_API_KEY=

# Initial Super Admin account, seeded on first boot
SUPER_ADMIN_EMAIL=superadmin@transport.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Port for the custom server (Next + Socket.io)
PORT=3000